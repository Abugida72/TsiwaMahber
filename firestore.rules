rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow all reads (members use phone+code auth without Firebase Auth,
    // so request.auth is null for them). Writes still require Firebase Auth.
    match /{document=**} {
      allow read: if true;
    }

    // Users collection
    match /users/{userId} {
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // Areas and all sub-collections
    match /areas/{areaId} {
      allow write: if request.auth != null;

      match /{subcollection}/{docId} {
        allow write: if request.auth != null;
      }

      match /{sub1}/{docId1}/{sub2}/{docId2} {
        allow write: if request.auth != null;
      }
    }

    // Developers collection
    match /developers/{email} {
      allow write: if request.auth != null;
    }
  }
}
